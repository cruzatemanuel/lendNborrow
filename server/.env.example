# lendNborrow Server Environment Configuration
#
# Create this file: copy `.env.example` → `.env`
# Place it at: server/.env (same directory as package.json)
# Never commit `.env` — it is already listed in server/.gitignore
# Commit only `.env.example` to version control.

# Port Express runs on. `npm --prefix server run dev` uses this.
PORT=3000

# Supabase project URL (from Supabase Dashboard → Settings → API)
# Example: https://xxxxx.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Key (public, used for client-like access; still kept server-side)
# From Supabase Dashboard → Settings → API → Project API keys → anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (privileged, bypasses RLS)
# NEVER expose this in frontend JavaScript — server-side only
# From Supabase Dashboard → Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...